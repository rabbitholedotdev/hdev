# Copy to `.env` in the repo root (gitignored). Existing process env wins.
# Values here are placeholders. Do not put live tokens in this file.

# --- Judge / CLI host (optional; empty = use PATH, skip wrappers) ---
# Extra PATH prefix for grok/codex/claude binaries on a homelab host.
HDEV_BIN_DIR=
# Wrapper that injects the current user's CLI account env (no credential copy).
HDEV_ACCOUNT_WRAPPER=
# `node <script> env` that prints KEY='value'; export KEY for Codex.
HDEV_CODEX_ENV_SCRIPT=
HDEV_CODEX_BIN=codex
HDEV_GROK_BIN=grok

# --- Isolated reviewers / worktrees ---
# Directory that marks "agent areas" (commit-turno isolation).
HDEV_AREAS=/srv/hdev/areas
HDEV_SCRATCH_DIR=
HDEV_MAIN=
HDEV_GROK_WORKTREE=
HDEV_GROK_BRANCH=grok/ci
HDEV_GROK_WRAPPER=
HDEV_GIT_BIN=

# --- Jev (TypeSafe System One). Key never goes to stdout. ---
# Leave TYPESAFE_API_KEY unset in git. Set it in the real `.env` or the process env.
TYPESAFE_API_KEY=
HDEV_JEV_REF=op://Vault/jev-api/credential
HDEV_JEV_MODEL=jev-latest
# CLI that prints a vault item given a reference (`op read`, or a host helper).
HDEV_KEY_HELPER=op
# Alias kept for older host installs:
# HDEV_RATOEIRA_CHAVE=

# --- Handoff socket (optional) ---
HDEV_AGENTS_SOCKET=
HDEV_HANDOFF_SOCKET=
HDEV_HANDOFF_WINDOW=
HDEV_HANDOFF_THRESHOLD=

# --- App profile contract on the host (optional) ---
HDEV_APPS_MD=

# --- Releases ---
HDEV_RELEASES_DIR=
